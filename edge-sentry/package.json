{
  "name": "edge-sentry",
  "private": true,
  "type": "module",
  "description": "Terrain EW/air sandbox ops agent (C++ sim + AIML track scoring)",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev",
    "build:native": "cmake -S native -B native/build -DCMAKE_CXX_COMPILER=g++ && cmake --build native/build -j",
    "sim": "native/build/edge-sim",
    "web": "bash web/run.sh",
    "test": "python3 native/tests/test_cli.py && python3 native/tests/test_planner.py",
    "test:web": "python3 web/test_sessions.py",
    "eval:model": "python3 ml/evaluate.py --check",
    "eval:outcome": "python3 ml/outcome.py --rollouts 40 --check --no-write",
    "eval:autonomy": "python3 ml/autonomy_eval.py --rollouts 30 --check --no-write",
    "sil": "python3 sil/run_sil.py --rollouts 12 --check --no-write",
    "eval:tracking": "python3 ml/tracking_eval.py --rollouts 20 --check --no-write",
    "eval:opponent": "python3 ml/opponent_eval.py --rollouts 20 --check --no-write",
    "eval:rl": "python3 ml/rl_eval.py --rollouts 30 --battles 16 --check --no-write",
    "test:rl": "python3 ml/test_rl.py",
    "train:rl": "python3 ml/rl_train.py",
    "trace": "python3 tools/trace.py --check",
    "docs:check": "python3 tools/check_docs.py"
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "minimatch": "^11.0.1"
  }
}
